{
  "name": "polca-net-cisc3024-assignment-3",
  "description": "Experiment configuration for the reimplementation of 'POLCA Net: Principal Orthogonal Latent Components Analysis' (arXiv:2410.07289).",
  "paper": {
    "title": "POLCA Net: Principal Orthogonal Latent Components Analysis",
    "arxiv_id": "2410.07289",
    "year": 2024,
    "authors": ["Martin H.", "Perozo F.", "Lopez M."]
  },
  "datasets": {
    "names": ["digits", "mnist", "fashion"],
    "digits": {
      "source": "sklearn.datasets.load_digits",
      "input_dim": 64,
      "image_shape": [8, 8],
      "num_classes": 10,
      "offline": true
    },
    "mnist": {
      "source": "torchvision.datasets.MNIST",
      "input_dim": 784,
      "image_shape": [28, 28],
      "num_classes": 10,
      "offline": false
    },
    "fashion": {
      "source": "torchvision.datasets.FashionMNIST",
      "input_dim": 784,
      "image_shape": [28, 28],
      "num_classes": 10,
      "offline": false
    },
    "test_size": 0.2,
    "split_seed": 5
  },
  "model": {
    "latent_dims": [8],
    "hidden_dims": [64, 32],
    "activation": "relu",
    "linear_decoder": false,
    "input_dim": "dataset dependent (64 for digits, 784 for mnist/fashion)"
  },
  "training": {
    "epochs": 100,
    "max_updates": 20000,
    "batch_size": 64,
    "lr": 0.001,
    "optimizer": "Adam",
    "seeds": [5],
    "device": "auto",
    "log_every": 50,
    "notes": "The paper trains for 20k gradient updates with batch size 64 and seed 5. 'max_updates' reproduces that budget exactly and is independent of the dataset size; 'epochs' is the equivalent CLI knob when max_updates is not set."
  },
  "loss": {
    "alpha": 0.01,
    "beta": 0.01,
    "gamma": 1e-07,
    "eps_com": 0.25,
    "terms": ["rec", "class", "ort", "com", "var"],
    "formula": "L_polca = L_rec + L_class + alpha*L_ort + beta*L_com + gamma*L_var"
  },
  "methods": [
    "pca",
    "lda",
    "ae",
    "polca",
    "polca_sup"
  ],
  "ablations": {
    "enabled": true,
    "variants": {
      "polca_full": {"use_ort": true, "use_com": true, "use_var": true},
      "polca_no_ort": {"use_ort": false, "use_com": true, "use_var": true},
      "polca_no_com": {"use_ort": true, "use_com": false, "use_var": true},
      "polca_no_var": {"use_ort": true, "use_com": true, "use_var": false}
    }
  },
  "classifiers": [
    "Perceptron",
    "Ridge",
    "LogisticRegression",
    "LinearSVM"
  ],
  "metrics": {
    "reconstruction": ["nrmse", "psnr", "ssim"],
    "latent": ["orthogonality_error", "variance_ordering_score"],
    "classification": ["accuracy", "f1_macro"]
  },
  "output": {
    "out_dir": "results",
    "figures_dir": "results/figures",
    "metrics_csv": "results/metrics.csv",
    "metrics_json": "results/metrics.json",
    "ablation_csv": "results/ablation.csv",
    "summary_md": "results/summary.md",
    "latents_npz": "results/latents.npz",
    "loss_history_json": "results/loss_history.json",
    "figures": [
      "reconstruction_grid.png",
      "latent_orthogonality.png",
      "variance_ordering.png",
      "latent_scatter.png",
      "classification_metrics.png",
      "ablation.png",
      "loss_curves.png",
      "dataset_summary.png"
    ]
  },
  "commands": {
    "train": "python src/train.py --dataset digits --latent-dim 8 --epochs 50 --out-dir results/train",
    "evaluate": "python src/evaluate.py --datasets digits mnist fashion --latent-dims 8 --epochs 100 --seeds 5 --out-dir results",
    "figures": "python src/make_figures.py --out-dir results",
    "test": "python tests/test_pipeline.py"
  }
}
