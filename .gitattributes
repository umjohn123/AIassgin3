# Normalise line endings: keep text files LF in the repository,
# check out with the platform default on Windows.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.npz binary
